  "items": [
    {
      "type": 1,
      "content": {
        "json": "\r\n# Office 365 Activity Dashboard\r\n## An interactive workbook that consolidates and visualizes user and admin activity across Teams, SharePoint, OneDrive, and Exchange—letting you filter by workload and user type, track event volumes and trends over time, and drill down into top operations and recent actions."
      },
      "name": "text - 14 - Copy"
    },
    {
      "type": 1,
      "content": {
        "json": "---\r\n# Teams"
      },
      "name": "text - 14 - Copy - Copy"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
